<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>QM_CentralManagement</AssemblyName>
    <RootNamespace>QM_CentralManagement</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyVersion>1.6.1.0</AssemblyVersion>
    <DebugType>none</DebugType>
    <!-- MSB3277: MCM.dll (net48) references System.IO.Compression 4.2.0.0
         while netstandard2.1 refs 4.1.3.0 and Unity ships its own 4.0.0.0
         build. Benign metadata conflict: Unity Mono unifies to 4.0.0.0 at
         runtime (MCM itself already runs in-game), so the binder warning is
         suppressed. -->
    <NoWarn>$(NoWarn);CS0436;NU1701;3277</NoWarn>
    <!-- Task-level warnings need MSBuildWarningsAsMessages, not NoWarn. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <GameManaged>D:\SteamLibrary\steamapps\common\Quasimorph\Quasimorph_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameManaged)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GameManaged)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MCM">
      <HintPath>libs\MCM.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\central_management_tech_active.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\central_management_tech_locked.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\central_management_fast.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\central_management_button_normal.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\central_management_button_hover.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\central_management_button_pressed.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
